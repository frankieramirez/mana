      else if (!incomplete && !cancelled) {
        const result = await execute(c.release, snapshot, report.evidenceDir, 'release', c.timeoutSeconds);
        const assessment = assessed(result, c.release.format === 'exit' ? ['release.command'] : expected, 'release.command', c.release.format);
        report.checks.push(assessment.check);
        incomplete ||= assessment.incomplete;
        report.artifacts.push(...assessment.check.artifacts);
      } else report.checks.push({ id: 'release.command', status: 'not_run', reason: 'feature or preparation was incomplete', argv: safeArgv(c.release.argv), expected: c.release.format === 'exit' ? ['release.command'] : expected, executed: [] });
    }
  } catch (error) {
    addBlocked(safe(error.message));
  } finally {
    if (before) {
      try {
        const after = identity(c);
        report.source.sourceChanged ||= after.head !== before.head || after.manifest.digest !== before.manifest.digest;
        if (snapshotFiles) {
          const paths = new Set(sourcePaths);
          for (const rel of [...c.sourceRoots, ...c.bindings, c.featuresDir, c.scenariosDir]) walk(report.snapshot.path, rel, paths);
          report.source.sourceChanged ||= hash(JSON.stringify(manifest(report.snapshot.path, [...paths].sort()))) !== before.manifest.digest;
        }
      } catch { report.source.sourceChanged = true; }
    }
    if (temp) {
      try { fs.rmSync(temp, { recursive: true, force: true }); report.snapshot.cleaned = true; }
      catch { incomplete = true; report.teardown = 'owned snapshot could not be removed'; }
    }
  }
  if (cancelled) { report.status = 'cancelled'; report.exit = cancelled === 'SIGINT' ? 130 : 143; }
  else if (incomplete || report.source.sourceChanged || !report.checks.length) { report.status = 'incomplete'; report.exit = 3; }
  else if (report.checks.some(check => check.status === 'failed')) { report.status = 'failed'; report.exit = 1; }
  else { report.status = 'passed'; report.exit = 0; }
  if (report.evidenceDir) {
    const reportFile = path.join(report.evidenceDir, 'report.json');
    report.artifacts.push(reportFile);
    try { fs.writeFileSync(reportFile, JSON.stringify(report, null, 2) + '\n', { mode: 0o600 }); }
    catch {
      report.artifacts = report.artifacts.filter(file => file !== reportFile);
      report.retention = 'run report could not be retained';
      if (!cancelled) { report.status = 'incomplete'; report.exit = 3; }
    }
  }
  write(report, report.exit);
}

try {
  const args = options(), c = configuration(), data = records(c), verb = args.words[0];
  if (verb === 'list') {
    const terms = (args.search || '').toLowerCase().split(/\s+/).filter(Boolean);
    const ranked = entries => entries.map(entry => ({ ...entry, score: terms.reduce((n, term) => n + (JSON.stringify(entry).toLowerCase().includes(term) ? 1 : 0), 0) }))
      .filter(entry => !terms.length || entry.score > 0).sort((a, b) => b.score - a.score || a.id.localeCompare(b.id));
    write({ contract, mode: 'discovery', features: ranked(data.features), scenarios: ranked(data.scenarios) }, 0);
  } else if (verb === 'describe') {
    const kind = args.words[1], record = data[kind === 'feature' ? 'features' : 'scenarios'].find(item => item.id === args.words[2]);
    if (!record) fail(`unknown ${kind}: ${args.words[2]}`, 2);
    write({ contract, mode: 'discovery', kind, record, scenarios: kind === 'feature' ? data.scenarios.filter(s => s.feature === record.id) : undefined, bindings: c.bindings, command: ['node', '--experimental-strip-types', 'scripts/control.ts', 'feature', kind === 'feature' ? record.id : record.feature, '--json'] }, 0);
  } else await run(c, data, args);
} catch (error) {
  write({ contract, mode: 'error', error: safe(error.message) }, [1, 2, 3].includes(error.code) ? error.code : 1);
}
