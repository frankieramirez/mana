def jq_lines(value, expr):
    """gh --jq output: each result on its own line, strings raw, everything else compact JSON."""
    out = []
    try:
        for x in evaluate(Parser(expr).parse(), value, {}):
            out.append(x if isinstance(x, str) else tojson(norm(x)))
    except (JqError, JqUnsupported, Break):
        raise
    except TypeError as exc:  # a value of the wrong type, which jq reports as an error too
        raise JqError('jq: error: %s' % exc)
    except Exception as exc:  # an evaluator gap, never shown as a traceback
        raise JqUnsupported('%s: %s' % (type(exc).__name__, exc))
    return out


# ----------------------------------------------------------------------------- GraphQL reads

class GqlError(Exception):
    pass


def gql_lex(src):
    tokens = []
    for m in re.finditer(r'"""(?:.|\n)*?"""|"(?:\\.|[^"\\])*"|\.\.\.|[{}()\[\]:!=$@,|&]|-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?|[_A-Za-z][_0-9A-Za-z]*|#[^\n]*|\s+', src):
        tok = m.group(0)
        if tok.isspace() or tok.startswith('#') or tok == ',':
            continue
        tokens.append(tok)
    return tokens


class Gql:
    def __init__(self, src, variables):
        self.t = gql_lex(src) + ['']
        self.i = 0
        self.variables = variables
        self.fragments = {}

    def take(self, value=None):
        tok = self.t[self.i]
        if value is not None and tok != value:
            raise GqlError('Parse error on "%s" (wanted %s)' % (tok, value))
        self.i += 1
        return tok

    def document(self):
        operation = None
        while self.t[self.i]:
            tok = self.t[self.i]
            if tok == 'fragment':
                self.take()
                name = self.take()
                self.take('on')
                self.take()
                self.fragments[name] = self.selection_set()
            elif tok in ('query', 'mutation', 'subscription') or tok == '{':
                kind = 'query'
                if tok != '{':
                    kind = self.take()
                    if self.t[self.i] not in ('{', '('):
                        self.take()
                    if self.t[self.i] == '(':
                        self.skip_parens()
                    while self.t[self.i] == '@':
                        self.take()
                        self.take()
                        if self.t[self.i] == '(':
                            self.skip_parens()
                operation = (kind, self.selection_set())
            else:
                raise GqlError('Parse error on "%s"' % tok)
        if operation is None:
            raise GqlError('No operation found')
        return operation

    def skip_parens(self):
        depth = 0
        while True:
            tok = self.take()
            depth += {'(': 1, ')': -1}.get(tok, 0)
            if depth == 0:
                return

    def selection_set(self):
        self.take('{')
        items = []
        while self.t[self.i] != '}':
            if self.t[self.i] == '...':
                self.take()
                if self.t[self.i] == 'on':
                    self.take()
                    self.take()
                    items.append(('inline', self.selection_set()))
                else:
                    items.append(('spread', self.take()))
                continue
            name = self.take()
            alias = name
            if self.t[self.i] == ':':
                self.take()
                name = self.take()
            args = self.arguments() if self.t[self.i] == '(' else {}
            while self.t[self.i] == '@':
                self.take()
                self.take()
                if self.t[self.i] == '(':
                    self.arguments()
            sub = self.selection_set() if self.t[self.i] == '{' else None
            items.append(('field', alias, name, args, sub))
        self.take('}')
        return items

    def arguments(self):
        self.take('(')
        args = {}
        while self.t[self.i] != ')':
            name = self.take()
            self.take(':')
            args[name] = self.value()
        self.take(')')
        return args

    def value(self):
        tok = self.take()
        if tok == '$':
            return self.variables.get(self.take())
        if tok == '[':
            out = []
            while self.t[self.i] != ']':
                out.append(self.value())
            self.take(']')
            return out
        if tok == '{':
            out = {}
            while self.t[self.i] != '}':
                key = self.take()
                self.take(':')
                out[key] = self.value()
            self.take('}')
            return out
        if tok.startswith('"'):
            return json.loads(tok) if not tok.startswith('"""') else tok[3:-3]
        if re.fullmatch(r'-?\d+', tok):
            return int(tok)
        if re.fullmatch(r'-?\d+(\.\d+)?([eE][+-]?\d+)?', tok):
            return float(tok)
        return {'true': True, 'false': False, 'null': None}.get(tok, tok)

    def flatten(self, items):
        for item in items:
            if item[0] == 'field':
                yield item
            elif item[0] == 'inline':
                yield from self.flatten(item[1])
            else:
                yield from self.flatten(self.fragments.get(item[1], []))


def resolve_root(name, args):
    if name == 'viewer':
        return {'login': VIEWER, 'name': 'Fixture Agent', 'id': 'U_fixture', '__typename': 'User'}
    if name == 'repository':
        owner, repo = args.get('owner'), args.get('name')
        if (owner, repo) != (OWNER, NAME):
            raise GqlError("Could not resolve to a Repository with the name '%s/%s'." % (owner, repo))
        return REPOSITORY
    if name == 'node':
        return NODES.get(args.get('id'))
    if name == 'nodes':
        return [NODES.get(i) for i in args.get('ids') or []]
    if name == 'rateLimit':
        return {'limit': 5000, 'remaining': 4999, 'cost': 1, 'used': 1, 'resetAt': '2026-10-03T00:00:00Z'}
    if name == '__typename':
        return 'Query'
    return KeyError


def project(gql, items, value, missing, path):
    if value is None:
        return None
    if isinstance(value, list):
        return [project(gql, items, x, missing, path) for x in value]
    out = {}
    for _, alias, name, args, sub in gql.flatten(items):
        if name == 'pullRequest' and value is REPOSITORY:
            if args.get('number') != 23:
                raise GqlError('Could not resolve to a PullRequest with the number of %s.' % args.get('number'))
            child = PR
        elif name in ('issueOrPullRequest', 'issue') and value is REPOSITORY:
            if args.get('number') != 23 or name == 'issue':
                raise GqlError('Could not resolve to an Issue with the number of %s.' % args.get('number'))
            child = PR
        elif name == 'pullRequests' and value is REPOSITORY:
            head = args.get('headRefName')
            child = connection([PR] if head in (None, HEAD) and 'CLOSED' not in str(args.get('states')) else [])
        elif name == 'reviewThreads' and value is PR:
            child = connection(THREADS)
        elif name in value:
            child = value[name]
        else:
            missing.append('.'.join(path + [name]))
            child = None
        out[alias] = project(gql, sub, child, missing, path + [name]) if sub is not None else child
    return out


def graphql_response(query, variables):
    gql = Gql(query, variables)
    kind, selection = gql.document()
    if kind != 'query':
        return 'mutation', None, []
    missing, data = [], {}
    for _, alias, name, args, sub in gql.flatten(selection):
        root = resolve_root(name, args)
        if root is KeyError:
            raise GqlError("Field '%s' doesn't exist on type 'Query'" % name)
        data[alias] = project(gql, sub, root, missing, [name]) if sub is not None else root
    return 'query', {'data': data}, missing


