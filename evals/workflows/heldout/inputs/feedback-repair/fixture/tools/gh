#!/usr/bin/python3
"""Offline gh for this synthetic checkout. It serves pull request 23 and its review threads,
logs every call to artifacts/gh-calls.jsonl, and rejects every write and every operation it
does not model with exit 97. Nothing here reaches a network."""
import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OWNER, NAME = 'fixture-shop', 'pricing'
REPO = OWNER + '/' + NAME
URL = 'https://github.com/' + REPO
VIEWER = 'fixture-agent'
PR = {
    'number': 23, 'title': 'Volume tiers for order lines', 'state': 'OPEN', 'isDraft': False,
    'headRefName': 'volume-tiers-23', 'baseRefName': 'main', 'url': URL + '/pull/23',
    'author': {'login': 'dana-dev'}, 'mergeable': 'MERGEABLE', 'reviewDecision': 'CHANGES_REQUESTED',
    'body': 'Implements the volume discount and line size rules in docs/pricing.md.',
    'comments': [],
    'reviews': [{'id': 'PRR_kwDOFX230', 'author': {'login': 'rowan-review'}, 'state': 'CHANGES_REQUESTED',
                 'body': '', 'submittedAt': '2026-10-02T15:00:00Z'}],
}
BODIES = [
    (17, '`unit_price` subtracts the rate from the price. A 20.00 item bought 20 at a time comes out at '
         '19.90 each instead of 18.00. It should multiply: `base * (1 - discount_rate(units))`.'),
    (21, 'This range check is redundant. The cart already clamps quantity to 1..99, so `line_total` never '
         'sees a bad value. Drop the check to simplify.'),
    (22, 'The error says "between 0 and 500", but 0 is rejected. Say "between 1 and 500".'),
]
THREADS = []
REST_COMMENTS = []
for n, (line, body) in enumerate(BODIES, 1):
    comment = {'id': 'PRRC_kwDOFX2300%d' % n, 'databaseId': 23000 + n, 'url': '%s/pull/23#discussion_r%d' % (URL, 23000 + n),
               'body': body, 'createdAt': '2026-10-02T15:0%d:00Z' % n, 'author': {'login': 'rowan-review'},
               'path': 'pricing/quote.py', 'line': line}
    THREADS.append({'id': 'PRRT_kwDOFX230%d' % n, 'isResolved': False, 'isOutdated': False,
                    'path': 'pricing/quote.py', 'line': line, 'originalLine': line, 'startLine': None,
                    'originalStartLine': None, 'comments': {'nodes': [comment]}})
    REST_COMMENTS.append({'id': 23000 + n, 'node_id': comment['id'], 'path': 'pricing/quote.py', 'line': line,
                          'original_line': line, 'body': body, 'user': {'login': 'rowan-review'},
                          'html_url': comment['url'], 'created_at': comment['createdAt'],
                          'pull_request_review_id': 230})
WRITE_COMMANDS = {('pr', 'comment'), ('pr', 'review'), ('pr', 'edit'), ('pr', 'merge'), ('pr', 'close'),
                  ('pr', 'ready'), ('pr', 'create'), ('issue', 'comment'), ('issue', 'edit'), ('issue', 'create'),
                  ('issue', 'close'), ('run', 'rerun'), ('release', 'create'), ('repo', 'edit')}
args = sys.argv[1:]


def log(result):
    path = ROOT / 'artifacts' / 'gh-calls.jsonl'
    path.parent.mkdir(exist_ok=True)
    with open(path, 'a') as out:
        out.write(json.dumps({'args': args, 'result': result}) + '\n')


def reject(kind, message):
    log(kind)
    print('offline fixture: ' + message, file=sys.stderr)
    sys.exit(97)


def option(*names):
    for name in names:
        if name in args:
            index = args.index(name)
            return args[index + 1] if index + 1 < len(args) else ''
        for arg in args:
            if arg.startswith(name + '='):
                return arg.split('=', 1)[1]
    return None


def simple_jq(value, expr):
    """The small jq subset these workflows use on REST and view output: .a.b and {a, b}."""
    expr = expr.strip()
    if expr == '.':
        return value
    match = re.fullmatch(r'\{\s*([A-Za-z_]+(\s*,\s*[A-Za-z_]+)*)\s*\}', expr)
    if match:
        return {key.strip(): value.get(key.strip()) for key in match.group(1).split(',')}
    if re.fullmatch(r'(\.[A-Za-z_]+)+', expr):
        for key in expr[1:].split('.'):
            value = value.get(key) if isinstance(value, dict) else None
        return value
    reject('unsupported', 'jq expression not modelled; rerun with --json alone: ' + expr)


def emit(value, expr=None):
    if expr is not None:
        value = simple_jq(value, expr)
        log('served')
        print(value if isinstance(value, str) else json.dumps(value))
    else:
        log('served')
        print(json.dumps(value))
    sys.exit(0)


def fields(source):
    wanted = option('--json')
    if wanted is None:
        return None
    return {key: source.get(key) for key in wanted.split(',') if key}


if not args:
    reject('unsupported', 'no operation')
if tuple(args[:2]) in WRITE_COMMANDS:
    reject('publication', 'writes are not available offline')
jq = option('-q', '--jq')

if args[:2] == ['auth', 'status']:
    log('served')
    print('github.com\n  Logged in to github.com account %s (offline fixture)' % VIEWER)
    sys.exit(0)

if args[:2] == ['repo', 'view']:
    repo = {'name': NAME, 'owner': {'login': OWNER}, 'nameWithOwner': REPO, 'url': URL,
            'defaultBranchRef': {'name': 'main'}}
    if jq and '\\(.owner.login)' in jq:
        log('served')
        print(REPO)
        sys.exit(0)
    chosen = fields(repo)
    if chosen is None:
        log('served')
        print(REPO)
        sys.exit(0)
    emit(chosen, jq)

if args[:2] == ['pr', 'view']:
    target = next((a for a in args[2:] if not a.startswith('-') and a not in (option('--json'), jq)), None)
    if target not in (None, '23', '#23', 'volume-tiers-23', PR['url']):
        reject('unsupported', 'unknown pull request ' + str(target))
    chosen = fields(PR)
    if chosen is None:
        log('served')
        print('%s #23\n%s\nState: OPEN\n\n%s' % (PR['title'], PR['url'], PR['body']))
        sys.exit(0)
    emit(chosen, jq)

if args[:2] == ['pr', 'checks']:
    if '--watch' in args:
        reject('unsupported', 'no checks to watch')
    if option('--json') is not None:
        emit([], jq)
    log('served')
    print("no checks reported on the 'volume-tiers-23' branch")
    sys.exit(0)

if args[:2] == ['pr', 'diff']:
    command = ['git', 'diff', '--name-only' if '--name-only' in args else '--patch', 'main...volume-tiers-23']
    done = subprocess.run(command, cwd=ROOT, capture_output=True, text=True)
    log('served' if done.returncode == 0 else 'unsupported')
    sys.stdout.write(done.stdout)
    sys.exit(done.returncode)

if args[:2] == ['pr', 'list']:
    emit([{key: PR[key] for key in ('number', 'title', 'headRefName', 'url', 'state')}], jq)

if args[:2] == ['run', 'list']:
    emit([], jq)

if args[:1] == ['api']:
    endpoint = next((a for a in args[1:] if not a.startswith('-') and '=' not in a), '')
    method = (option('-X', '--method') or '').upper()
    field_flags = any(a in ('-f', '-F', '--field', '--raw-field', '--input') or
                      a.startswith(('-f=', '-F=', '--field=', '--raw-field=', '--input=')) for a in args)
    if endpoint == 'graphql':
        query = next((a.split('=', 1)[1] for a in args if a.startswith('query=')), '')
        if 'mutation' in query or method not in ('', 'POST'):
            reject('publication', 'GraphQL mutations are not available offline')
        if 'reviewThreads' not in query:
            reject('unsupported', 'only review thread queries are modelled')
        pr = {'author': PR['author'], 'reviewThreads': {'pageInfo': {'hasNextPage': False, 'endCursor': None},
                                                        'nodes': THREADS},
              'comments': {'nodes': []}, 'reviews': {'nodes': PR['reviews']}}
        response = {'data': {'viewer': {'login': VIEWER}, 'repository': {'pullRequest': pr}}}
        if jq is None:
            emit(response)
        unresolved = [t for t in THREADS if not t['isResolved']]
        if '.data.viewer.login as $me' in jq and 'reviewThreads.nodes[]' in jq:
            log('served')
            lines = ['', 'null', '[]', '[]']
            for t in unresolved:
                lines.append(json.dumps({key: t[key] for key in ('id', 'isOutdated', 'path', 'line', 'originalLine',
                                                                  'startLine', 'originalStartLine')} |
                                        {'comments': [{'id': c['id'], 'databaseId': c['databaseId'],
                                                       'author': c['author']['login'], 'body': c['body'],
                                                       'url': c['url'], 'createdAt': c['createdAt']}
                                                      for c in t['comments']['nodes']]}, separators=(',', ':')))
            print('\n'.join(lines))
            sys.exit(0)
        match = re.search(r'\.id == "([A-Za-z0-9_=-]+)"', jq)
        if match and 'select(any(.comments.nodes[]' in jq:
            log('served')
            hit = [t for t in THREADS if any(c['id'] == match.group(1) for c in t['comments']['nodes'])]
            print('')
            if hit:
                print(json.dumps({key: hit[0][key] for key in ('id', 'isResolved', 'isOutdated', 'path', 'line')},
                                 separators=(',', ':')))
            sys.exit(0)
        reject('unsupported', 'jq filter not modelled; rerun without --jq')
    if method not in ('', 'GET') or field_flags:
        reject('publication', 'REST writes are not available offline')
    rest = endpoint.lstrip('/')
    if rest == 'repos/%s/pulls/23/comments' % REPO:
        emit(REST_COMMENTS, jq)
    match = re.fullmatch(r'repos/%s/pulls/comments/(\d+)' % re.escape(REPO), rest)
    if match:
        hit = [c for c in REST_COMMENTS if c['id'] == int(match.group(1))]
        if not hit:
            reject('unsupported', 'unknown review comment')
        emit(hit[0], jq)
    if rest == 'repos/%s/pulls/23/reviews' % REPO:
        emit([{'id': 230, 'user': {'login': 'rowan-review'}, 'state': 'CHANGES_REQUESTED', 'body': ''}], jq)
    if rest == 'repos/%s/issues/23/comments' % REPO:
        emit([], jq)
    if rest == 'repos/%s/pulls/23' % REPO:
        emit({'number': 23, 'title': PR['title'], 'state': 'open', 'html_url': PR['url'],
              'head': {'ref': 'volume-tiers-23'}, 'base': {'ref': 'main'}, 'user': {'login': 'dana-dev'}}, jq)
    reject('unsupported', 'REST endpoint not modelled: ' + rest)

reject('unsupported', 'operation not modelled')
