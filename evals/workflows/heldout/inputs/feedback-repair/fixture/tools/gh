def setpath(v, path, value):
    if not path:
        return value
    head, rest = path[0], path[1:]
    if isinstance(head, str):
        out = dict(v or {})
        out[head] = setpath(out.get(head), rest, value)
        return out
    out = list(v or [])
    while len(out) <= head:
        out.append(None)
    out[head] = setpath(out[head], rest, value)
    return out


def length(v):
    if v is None:
        return 0
    if isinstance(v, bool):
        raise JqError('boolean (%s) has no length' % tojson(v))
    if isinstance(v, (int, float)):
        return abs(v)
    return len(v)


def add_all(items):
    acc = None
    for x in items:
        acc = binop('+', acc, x)
    return acc


def unique_by(items, f):
    out, seen = [], []
    for x in sorted(items, key=lambda y: sort_key(f(y))):
        k = sort_key(f(x))
        if k not in seen:
            seen.append(k)
            out.append(x)
    return out


def flatten(v, depth):
    out = []
    for x in v:
        if isinstance(x, list) and depth > 0:
            out.extend(flatten(x, depth - 1))
        else:
            out.append(x)
    return out


def tonumber(v):
    if jtype(v) == 'number':
        return v
    try:
        return norm(float(v)) if re.search(r'[.eE]', v) else int(v)
    except (TypeError, ValueError):
        raise JqError('Cannot parse %s as JSON' % tojson(v))


def from_entries(entries):
    out = {}
    for e in entries:
        k = next((e[x] for x in ('key', 'k', 'name', 'Name', 'Key', 'K') if x in e and e[x] is not None), None)
        val = next((e[x] for x in ('value', 'v', 'Value', 'V') if x in e), None)
        out[k if isinstance(k, str) else tojson(k)] = val
    return out


def contains(a, b):
    if isinstance(a, dict) and isinstance(b, dict):
        return all(k in a and contains(a[k], x) for k, x in b.items())
    if isinstance(a, list) and isinstance(b, list):
        return all(any(contains(x, y) for x in a) for y in b)
    if isinstance(a, str) and isinstance(b, str):
        return b in a
    if jtype(a) == jtype(b):
        return a == b
    raise JqError('%s (%s) and %s (%s) cannot have their containment checked' % (jtype(a), tojson(a)[:20], jtype(b), tojson(b)[:20]))


