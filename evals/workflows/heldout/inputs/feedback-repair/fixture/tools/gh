        for name in names:
            if arg == name and i + 1 < len(ARGS):
                return ARGS[i + 1]
            if arg.startswith(name + '=') and name.startswith('--'):
                return arg.split('=', 1)[1]
            if len(name) == 2 and arg.startswith(name) and len(arg) > 2 and not name.startswith('--'):
                return arg[2:]
    return None


