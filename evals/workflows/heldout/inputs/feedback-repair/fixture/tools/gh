def fields_to_vars(flags):
    out = {}
    for flag, raw in flags:
        if '=' not in raw:
            continue
        k, val = raw.split('=', 1)
        if flag in ('-F', '--field'):
            val = expand(val)
            if re.fullmatch(r'-?\d+', val):
                val = int(val)
            elif val in ('true', 'false', 'null'):
                val = {'true': True, 'false': False, 'null': None}[val]
            elif val.startswith('@'):
                try:
                    val = pathlib.Path(val[1:]).read_text()
                except OSError:
                    gh_error('open %s: no such file or directory' % val[1:])
        out[k] = val
    return out


def field_flags():
