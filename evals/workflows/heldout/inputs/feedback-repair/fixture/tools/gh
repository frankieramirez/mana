# ----------------------------------------------------------------------------- jq evaluator

class JqError(Exception):
    """A jq runtime error, reported the way gh reports jq errors."""


class JqUnsupported(Exception):
    """jq syntax or a builtin this evaluator does not implement."""


class Break(Exception):
    pass


KEYWORDS = {'if', 'then', 'elif', 'else', 'end', 'as', 'def', 'reduce', 'foreach', 'try', 'catch', 'label',
            'import', 'include', 'and', 'or', '__loc__'}
OPS = ('?//', '//=', '|=', '+=', '-=', '*=', '/=', '%=', '==', '!=', '<=', '>=', '//', '..', 'and', 'or')


def lex(src):
    tokens, i = [], 0
    while i < len(src):
        c = src[i]
        if c.isspace():
            i += 1
        elif c == '#':
            while i < len(src) and src[i] != '\n':
                i += 1
        elif c == '"':
            parts, i = lex_string(src, i + 1)
            tokens.append(('str', parts))
        elif c.isdigit() or (c == '.' and i + 1 < len(src) and src[i + 1].isdigit() and
                             (not tokens or tokens[-1][0] in ('op',) and tokens[-1][1] not in (')', ']', '}'))):
            m = re.match(r'\d*\.?\d+(?:[eE][+-]?\d+)?|\d+\.', src[i:])
            tokens.append(('num', float(m.group(0)) if re.search(r'[.eE]', m.group(0)) else int(m.group(0))))
            i += len(m.group(0))
        elif c == '.' and i + 1 < len(src) and (src[i + 1].isalpha() or src[i + 1] == '_'):
            m = re.match(r'[A-Za-z_][A-Za-z0-9_]*', src[i + 1:])
            tokens.append(('field', m.group(0)))
            i += 1 + len(m.group(0))
        elif c == '$':
            m = re.match(r'\$(__loc__|[A-Za-z_][A-Za-z0-9_]*)', src[i:])
            if not m:
                raise JqUnsupported('bad variable')
            tokens.append(('var', m.group(1)))
            i += len(m.group(0))
        elif c == '@':
            m = re.match(r'@([A-Za-z0-9_]+)', src[i:])
            tokens.append(('format', m.group(1)))
            i += len(m.group(0))
        elif c.isalpha() or c == '_':
            m = re.match(r'[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*', src[i:])
            word = m.group(0)
            tokens.append(('op', word) if word in KEYWORDS else ('ident', word))
            i += len(word)
        else:
            for op in OPS:
                if src.startswith(op, i) and not op.isalpha():
                    tokens.append(('op', op))
                    i += len(op)
                    break
            else:
                if c not in '.|,()[]{}:;?<>+-*/%=':
                    raise JqUnsupported('cannot parse character %r' % c)
                tokens.append(('op', c))
                i += 1
    tokens.append(('eof', None))
    return tokens


def lex_string(src, i):
    parts, buf = [], []
    escapes = {'n': '\n', 't': '\t', 'r': '\r', 'b': '\b', 'f': '\f', '"': '"', '\\': '\\', '/': '/'}
    while i < len(src):
        c = src[i]
        if c == '"':
            parts.append(''.join(buf))
            return parts, i + 1
        if c == '\\':
            nxt = src[i + 1]
            if nxt == '(':
                parts.append(''.join(buf))
                buf = []
                depth, j = 1, i + 2
                while depth:
                    if src[j] == '"':
                        _, j = lex_string(src, j + 1)
                        continue
                    depth += {'(': 1, ')': -1}.get(src[j], 0)
                    j += 1
                parts.append(Parser(src[i + 2:j - 1]).parse())
                i = j
                continue
            if nxt == 'u':
                buf.append(chr(int(src[i + 2:i + 6], 16)))
                i += 6
                continue
            buf.append(escapes.get(nxt, nxt))
            i += 2
            continue
        buf.append(c)
        i += 1
    raise JqUnsupported('unterminated string')


class Parser:
    def __init__(self, src):
        self.t = lex(src)
        self.i = 0

    def peek(self, k=0):
        return self.t[self.i + k]

    def take(self, kind=None, value=None):
        tok = self.t[self.i]
        if (kind and tok[0] != kind) or (value is not None and tok[1] != value):
            raise JqUnsupported('jq syntax: wanted %s %s at %r' % (kind, value, tok))
        self.i += 1
        return tok

    def at(self, value, kind='op'):
        tok = self.t[self.i]
        return tok[0] == kind and tok[1] == value

    def parse(self):
        node = self.pipe()
        if self.peek()[0] != 'eof':
            raise JqUnsupported('jq syntax: trailing %r' % (self.peek(),))
        return node

    def pipe(self, no_comma=False):
        if self.at('def'):
            raise JqUnsupported('def is not supported')
        start = self.i
        try:
            term = self.postfix()
            if self.at('as'):
                self.take()
                names = self.pattern()
                self.take('op', '|')
                return ('as', term, names, self.pipe(no_comma))
        except JqUnsupported:
            pass
        self.i = start
        left = self.alt() if no_comma else self.comma()
        if self.at('|'):
            self.take()
            return ('pipe', left, self.pipe(no_comma))
        return left

    def pattern(self):
        if self.peek()[0] == 'var':
            return ('pvar', self.take()[1])
        if self.at('['):
            self.take()
            items = [self.pattern()]
            while self.at(','):
                self.take()
                items.append(self.pattern())
            self.take('op', ']')
            return ('parray', items)
        if self.at('{'):
            self.take()
            items = []
            while True:
                if self.peek()[0] == 'var':
                    name = self.take()[1]
                    items.append((('lit', name), ('pvar', name)))
                else:
                    key = self.take('ident')[1] if self.peek()[0] == 'ident' else None
                    if key is None:
                        tok = self.take('str')
                        key = tok[1][0]
                    self.take('op', ':')
                    items.append((('lit', key), self.pattern()))
                if not self.at(','):
                    break
                self.take()
            self.take('op', '}')
            return ('pobject', items)
        raise JqUnsupported('destructuring pattern')

    def comma(self):
        node = self.alt()
        while self.at(','):
            self.take()
            node = ('comma', node, self.alt())
        return node

    def alt(self):
        node = self.assign()
        if self.at('//'):
            self.take()
            return ('alt', node, self.alt())
        return node

    def assign(self):
        node = self.orx()
        for op in ('|=', '+=', '-=', '*=', '/=', '%=', '//=', '='):
            if self.at(op):
                self.take()
                return ('assign', op, node, self.orx())
        return node

    def orx(self):
        node = self.andx()
        while self.at('or'):
            self.take()
            node = ('or', node, self.andx())
        return node

    def andx(self):
        node = self.cmp()
        while self.at('and'):
            self.take()
            node = ('and', node, self.cmp())
        return node

    def cmp(self):
        node = self.add()
        for op in ('==', '!=', '<=', '>=', '<', '>'):
            if self.at(op):
                self.take()
                return ('bin', op, node, self.add())
        return node

    def add(self):
        node = self.mul()
        while self.at('+') or self.at('-'):
            op = self.take()[1]
            node = ('bin', op, node, self.mul())
        return node

    def mul(self):
        node = self.unary()
        while self.at('*') or self.at('/') or self.at('%'):
            op = self.take()[1]
            node = ('bin', op, node, self.unary())
        return node

    def unary(self):
        if self.at('-'):
            self.take()
            return ('neg', self.postfix())
        return self.postfix()

    def postfix(self):
        node = self.primary()
        while True:
            tok = self.peek()
            if tok[0] == 'field':
                self.take()
                node = ('pipe', node, ('field', tok[1]))
            elif self.at('.') and self.peek(1)[0] == 'str':
                self.take()
                node = ('pipe', node, ('field', self.string_key(self.take())))
            elif self.at('.') and self.peek(1) == ('op', '['):
                self.take()
            elif self.at('['):
                node = ('pipe', node, self.bracket())
            elif self.at('?'):
                self.take()
                node = ('try', node, None)
            else:
                return node

    def string_key(self, tok):
        parts = tok[1]
        if len(parts) != 1:
            raise JqUnsupported('interpolated key')
        return parts[0]

    def bracket(self):
        self.take('op', '[')
        if self.at(']'):
            self.take()
            return ('iter',)
        if self.at(':'):
            self.take()
            hi = self.pipe()
            self.take('op', ']')
            return ('slice', None, hi)
        lo = self.pipe()
        if self.at(':'):
            self.take()
            hi = None if self.at(']') else self.pipe()
            self.take('op', ']')
            return ('slice', lo, hi)
        self.take('op', ']')
        return ('index', lo)

    def primary(self):
        tok = self.peek()
        kind, value = tok
        if kind == 'field':
            self.take()
            return ('field', value)
        if kind == 'num':
            self.take()
            return ('lit', value)
        if kind == 'str':
            self.take()
            return ('string', value, None)
        if kind == 'format':
            self.take()
            if self.peek()[0] == 'str':
                return ('string', self.take()[1], value)
            return ('format', value)
        if kind == 'var':
            self.take()
            return ('var', value)
        if kind == 'op':
            if value == '.':
                self.take()
                if self.peek()[0] == 'str':
                    return ('field', self.string_key(self.take()))
                if self.at('['):
                    return self.bracket()
                return ('dot',)
            if value == '..':
                self.take()
                return ('recurse',)
            if value == '(':
                self.take()
                node = self.pipe()
                self.take('op', ')')
                return node
            if value == '[':
                self.take()
                if self.at(']'):
                    self.take()
                    return ('array', None)
                node = self.pipe()
                self.take('op', ']')
                return ('array', node)
            if value == '{':
                return self.object()
            if value == 'if':
                return self.ifx()
            if value == 'try':
                self.take()
                body = self.postfix()
                handler = None
                if self.at('catch'):
                    self.take()
                    handler = self.postfix()
                return ('try', body, handler)
            if value == 'reduce':
                self.take()
                source = self.postfix()
                self.take('op', 'as')
                pat = self.pattern()
                self.take('op', '(')
                init = self.pipe()
                self.take('op', ';')
                update = self.pipe()
                self.take('op', ')')
                return ('reduce', source, pat, init, update)
            if value == 'foreach':
                self.take()
                source = self.postfix()
                self.take('op', 'as')
                pat = self.pattern()
                self.take('op', '(')
                init = self.pipe()
                self.take('op', ';')
                update = self.pipe()
                extract = None
                if self.at(';'):
                    self.take()
                    extract = self.pipe()
                self.take('op', ')')
                return ('foreach', source, pat, init, update, extract)
            if value == 'label':
                self.take()
                name = self.take('var')[1]
                self.take('op', '|')
                return ('label', name, self.pipe())
        if kind == 'ident':
            self.take()
            if value in ('true', 'false', 'null'):
                return ('lit', {'true': True, 'false': False, 'null': None}[value])
            if value == 'break':
                return ('break', self.take('var')[1])
            args = []
            if self.at('('):
                self.take()
                args.append(self.pipe())
                while self.at(';'):
                    self.take()
                    args.append(self.pipe())
                self.take('op', ')')
            return ('call', value, args)
        raise JqUnsupported('jq syntax near %r' % (tok,))

    def ifx(self):
        self.take('op', 'if')
        cond = self.pipe()
        self.take('op', 'then')
        then = self.pipe()
        if self.at('elif'):
            self.t[self.i] = ('op', 'if')
            return ('if', cond, then, self.ifx())
        other = ('dot',)
        if self.at('else'):
            self.take()
            other = self.pipe()
        self.take('op', 'end')
        return ('if', cond, then, other)

    def object(self):
        self.take('op', '{')
        entries = []
        while not self.at('}'):
            tok = self.peek()
            if tok[0] == 'var':
                self.take()
                entries.append((('lit', tok[1]), ('var', tok[1])))
            else:
                if tok[0] in ('ident',) or (tok[0] == 'op' and tok[1] in KEYWORDS):
                    self.take()
                    key = ('lit', tok[1])
                elif tok[0] == 'str':
                    self.take()
                    key = ('string', tok[1], None)
                elif tok[0] == 'format':
                    self.take()
                    key = ('string', self.take('str')[1], tok[1]) if self.peek()[0] == 'str' else ('format', tok[1])
                elif tok[0] == 'num':
                    self.take()
                    key = ('lit', tok[1])
                elif self.at('('):
                    self.take()
                    key = self.pipe()
                    self.take('op', ')')
                else:
                    raise JqUnsupported('object key %r' % (tok,))
                if self.at(':'):
                    self.take()
                    value = self.pipe(no_comma=True)
                elif key[0] == 'lit':
                    value = ('field', key[1])
                elif key[0] == 'string':
                    value = ('field_of', key)
                else:
                    raise JqUnsupported('object entry')
                entries.append((key, value))
            if self.at(','):
                self.take()
            elif not self.at('}'):
                raise JqUnsupported('object syntax')
        self.take('op', '}')
        return ('object', entries)


def jtype(v):
    if v is None:
        return 'null'
    if isinstance(v, bool):
        return 'boolean'
    if isinstance(v, (int, float)):
        return 'number'
    if isinstance(v, str):
        return 'string'
    if isinstance(v, list):
        return 'array'
    return 'object'


ORDER = {'null': 0, 'boolean': 1, 'number': 2, 'string': 3, 'array': 4, 'object': 5}


def sort_key(v):
    t = jtype(v)
    if t == 'boolean':
        return (1, int(v))
    if t == 'array':
        return (4, [sort_key(x) for x in v])
    if t == 'object':
        keys = sorted(v)
        return (5, keys, [sort_key(v[k]) for k in keys])
    return (ORDER[t], v if t != 'null' else 0)


def truthy(v):
    return v is not None and v is not False


def norm(v):
    if isinstance(v, float) and v.is_integer() and abs(v) < 1e17:
        return int(v)
    return v


def tojson(v):
    return json.dumps(v, separators=(',', ':'), ensure_ascii=False)


def tostr(v):
    return v if isinstance(v, str) else tojson(v)


def fmt(name, v):
    if name in ('text',):
        return tostr(v)
    if name == 'json':
        return tojson(v)
    if name == 'base64':
        return base64.b64encode(tostr(v).encode()).decode()
    if name == 'base64d':
        return base64.b64decode(tostr(v)).decode('utf-8', 'replace')
    if name == 'base32':
        return base64.b32encode(tostr(v).encode()).decode()
    if name == 'base32d':
        return base64.b32decode(tostr(v)).decode('utf-8', 'replace')
    if name == 'uri':
        return urllib.parse.quote(tostr(v), safe='-_.~')
    if name == 'html':
        return tostr(v).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace("'", '&#39;').replace('"', '&quot;')
    if name in ('csv', 'tsv', 'sh'):
        items = v if isinstance(v, list) else [v]
        out = []
        for x in items:
            if isinstance(x, str):
                if name == 'csv':
                    out.append('"%s"' % x.replace('"', '""'))
                elif name == 'tsv':
                    out.append(x.replace('\\', '\\\\').replace('\t', '\\t').replace('\n', '\\n').replace('\r', '\\r'))
                else:
                    out.append("'%s'" % x.replace("'", "'\\''"))
            elif isinstance(x, (list, dict)):
                raise JqError('%s cannot be %s-formatted' % (jtype(x), name))
            else:
                out.append(tostr(x) if x is not None else '')
        return {'csv': ',', 'tsv': '\t', 'sh': ' '}[name].join(out)
    raise JqUnsupported('format @' + name)


def binop(op, a, b):
    ta, tb = jtype(a), jtype(b)
    if op == '==':
        return sort_key(a) == sort_key(b)
    if op == '!=':
        return sort_key(a) != sort_key(b)
    if op in ('<', '<=', '>', '>='):
        ka, kb = sort_key(a), sort_key(b)
        return {'<': ka < kb, '<=': ka <= kb, '>': ka > kb, '>=': ka >= kb}[op]
    if op == '+':
        if a is None:
            return b
        if b is None:
            return a
        if ta == tb == 'number':
            return norm(a + b)
        if ta == tb and ta in ('string', 'array'):
            return a + b
        if ta == tb == 'object':
            return dict(a, **b)
    elif op == '-':
        if ta == tb == 'number':
            return norm(a - b)
        if ta == tb == 'array':
            return [x for x in a if all(sort_key(x) != sort_key(y) for y in b)]
    elif op == '*':
        if ta == tb == 'number':
            return norm(a * b)
        if ta == 'string' and tb == 'number':
            return a * int(b) if b > 0 else None
        if ta == tb == 'object':
            return deep_merge(a, b)
    elif op == '/':
        if ta == tb == 'number':
            if b == 0:
                raise JqError('%s and %s cannot be divided because the divisor is zero' % (tojson(a), tojson(b)))
            return norm(a / b)
        if ta == tb == 'string':
            return a.split(b) if b else list(a)
    elif op == '%':
        if ta == tb == 'number':
            if int(b) == 0:
                raise JqError('cannot be divided because the divisor is zero')
            return int(math.fmod(int(a), int(b)))
    raise JqError('%s (%s) and %s (%s) cannot be combined with %s' % (ta, tojson(a)[:20], tb, tojson(b)[:20], op))


def deep_merge(a, b):
    out = dict(a)
    for k, v in b.items():
        out[k] = deep_merge(out[k], v) if isinstance(out.get(k), dict) and isinstance(v, dict) else v
    return out


def bind(pattern, value, env):
    kind = pattern[0]
    if kind == 'pvar':
        return dict(env, **{pattern[1]: value})
    if kind == 'parray':
        for i, sub in enumerate(pattern[1]):
            env = bind(sub, value[i] if isinstance(value, list) and i < len(value) else None, env)
        return env
    for key, sub in pattern[1]:
        env = bind(sub, value.get(key[1]) if isinstance(value, dict) else None, env)
    return env


def index_value(v, k):
    if v is None:
        return None
    if isinstance(k, str):
        if isinstance(v, dict):
            return v.get(k)
        raise JqError('Cannot index %s with "%s"' % (jtype(v), k))
    if isinstance(k, (int, float)) and not isinstance(k, bool):
        if isinstance(v, list):
            k = int(math.floor(k))
            if k < 0:
                k += len(v)
            return v[k] if 0 <= k < len(v) else None
        raise JqError('Cannot index %s with number' % jtype(v))
    if isinstance(k, dict) and isinstance(v, list):
        return slice_value(v, k.get('start'), k.get('end'))
    raise JqError('Cannot index %s with %s' % (jtype(v), jtype(k)))


def slice_value(v, lo, hi):
    if v is None:
        return None
    if not isinstance(v, (list, str)):
        raise JqError('Cannot index %s with object' % jtype(v))
    lo = 0 if lo is None else int(math.floor(lo))
    hi = len(v) if hi is None else int(math.ceil(hi))
    return v[lo:hi]


def iterate(v):
    if isinstance(v, list):
        return list(v)
    if isinstance(v, dict):
        return list(v.values())
    raise JqError('Cannot iterate over %s' % (jtype(v) + (' (%s)' % tojson(v) if v is not None else '')))


def regex(pattern, flags):
    flags = flags or ''
    py = 0
    if 'i' in flags:
        py |= re.IGNORECASE
    if 'x' in flags:
        py |= re.VERBOSE
    if 's' in flags:
        py |= re.DOTALL
    pattern = re.sub(r'\(\?<([A-Za-z_][A-Za-z0-9_]*)>', r'(?P<\1>', pattern)
    try:
        return re.compile(pattern, py | re.MULTILINE * 0), 'g' in flags
    except re.error as exc:
        raise JqError('%s (at offset %s) is not a valid regex' % (pattern, exc.pos))


def match_objects(s, pattern, flags, force_global=False):
    rx, glob = regex(pattern, flags)
    found = rx.finditer(s) if (glob or force_global) else [m for m in [rx.search(s)] if m]
    out = []
    names = {v: k for k, v in rx.groupindex.items()}
    for m in found:
        caps = []
        for g in range(1, (rx.groups or 0) + 1):
            caps.append({'offset': m.start(g) if m.group(g) is not None else -1, 'length': len(m.group(g) or ''),
                         'string': m.group(g), 'name': names.get(g)})
        out.append({'offset': m.start(), 'length': len(m.group(0)), 'string': m.group(0), 'captures': caps})
    return out


def iso_parse(s):
    return datetime.datetime.strptime(s.replace('Z', '+0000'), '%Y-%m-%dT%H:%M:%S%z').timestamp()


def assign_values(node, v, env):
    op, lhs, rhs = node[1], node[2], node[3]
    paths = list(paths_of(lhs, v, env))
    if op == '|=':
        out = v
        for path in paths:
            new = next(iter(evaluate(rhs, getpath(out, path), env)), Break)
            out = delpaths(out, [path]) if new is Break else setpath(out, path, new)
        yield out
        return
    for right in evaluate(rhs, v, env):
        out = v
        for path in paths:
            if op == '=':
                new = right
            elif op == '//=':
                old = getpath(out, path)
                new = old if truthy(old) else right
            else:
                new = binop(op[:-1], getpath(out, path), right)
            out = setpath(out, path, new)
        yield out


def evaluate(node, v, env):
    kind = node[0]
    if kind == 'dot':
        yield v
    elif kind == 'assign':
        yield from assign_values(node, v, env)
    elif kind == 'field':
        yield index_value(v, node[1])
    elif kind == 'field_of':
        for key in evaluate(node[1], v, env):
            yield index_value(v, key)
    elif kind == 'lit':
        yield node[1]
    elif kind == 'string':
        yield from string_values(node[1], node[2], v, env)
    elif kind == 'format':
        yield fmt(node[1], v)
    elif kind == 'var':
        if node[1] == '__loc__':
            yield {'file': '<stdin>', 'line': 1}
        elif node[1] == 'ENV':
            yield dict(os.environ)
        elif node[1] not in env:
            raise JqError('jq: error: $%s is not defined' % node[1])
        else:
            yield env[node[1]]
    elif kind == 'pipe':
        for x in evaluate(node[1], v, env):
            yield from evaluate(node[2], x, env)
    elif kind == 'comma':
        yield from evaluate(node[1], v, env)
        yield from evaluate(node[2], v, env)
    elif kind == 'as':
        for value in evaluate(node[1], v, env):
            yield from evaluate(node[3], v, bind(node[2], value, env))
    elif kind == 'iter':
        yield from iterate(v)
    elif kind == 'index':
        for k in evaluate(node[1], v, env):
            yield index_value(v, k)
    elif kind == 'slice':
        los = list(evaluate(node[1], v, env)) if node[1] else [None]
        his = list(evaluate(node[2], v, env)) if node[2] else [None]
        for hi in his:
            for lo in los:
                yield slice_value(v, lo, hi)
    elif kind == 'recurse':
        yield from recurse(v)
    elif kind == 'array':
        yield [] if node[1] is None else list(evaluate(node[1], v, env))
    elif kind == 'object':
        results = [{}]
        for key_node, value_node in node[1]:
            new = []
            for partial in results:
                for key in evaluate(key_node, v, env):
                    if not isinstance(key, str):
                        raise JqError('Object keys must be strings')
                    for value in evaluate(value_node, v, env):
                        new.append(dict(partial, **{key: value}))
            results = new
        yield from results
    elif kind == 'neg':
        for x in evaluate(node[1], v, env):
            if jtype(x) != 'number':
                raise JqError('%s cannot be negated' % jtype(x))
            yield -x
    elif kind == 'bin':
        for b in evaluate(node[3], v, env):
            for a in evaluate(node[2], v, env):
                yield binop(node[1], a, b)
    elif kind == 'and':
        for a in evaluate(node[1], v, env):
            if not truthy(a):
                yield False
            else:
                for b in evaluate(node[2], v, env):
                    yield truthy(b)
    elif kind == 'or':
        for a in evaluate(node[1], v, env):
            if truthy(a):
                yield True
            else:
                for b in evaluate(node[2], v, env):
                    yield truthy(b)
    elif kind == 'alt':
        found = False
        try:
            for x in evaluate(node[1], v, env):
                if truthy(x):
                    found = True
                    yield x
        except (JqError, TypeError):
            pass
        if not found:
            yield from evaluate(node[2], v, env)
    elif kind == 'if':
        for c in evaluate(node[1], v, env):
            yield from evaluate(node[2] if truthy(c) else node[3], v, env)
    elif kind == 'try':
        try:
            for x in evaluate(node[1], v, env):
                yield x
        except (JqError, TypeError) as exc:
            if node[2] is not None:
                yield from evaluate(node[2], str(exc), env)
    elif kind == 'reduce':
        for acc in evaluate(node[3], v, env):
            for item in evaluate(node[1], v, env):
                results = list(evaluate(node[4], acc, bind(node[2], item, env)))
                acc = results[-1] if results else None
            yield acc
    elif kind == 'foreach':
        for acc in evaluate(node[3], v, env):
            for item in evaluate(node[1], v, env):
                scope = bind(node[2], item, env)
                for acc in evaluate(node[4], acc, scope):
                    yield from (evaluate(node[5], acc, scope) if node[5] else [acc])
    elif kind == 'label':
        try:
            yield from evaluate(node[2], v, dict(env, **{'*label*' + node[1]: True}))
        except Break:
            return
    elif kind == 'break':
        raise Break(node[1])
    elif kind == 'call':
        yield from call(node[1], node[2], v, env)
    else:
        raise JqUnsupported(kind)


def string_values(parts, format_name, v, env):
    results = ['']
    for part in parts:
        if isinstance(part, str):
            results = [r + part for r in results]
        else:
            values = list(evaluate(part, v, env))
            results = [r + (fmt(format_name, x) if format_name else tostr(x)) for r in results for x in values]
    return results


def recurse(v):
    yield v
    if isinstance(v, list):
        for x in v:
            yield from recurse(x)
    elif isinstance(v, dict):
        for x in v.values():
            yield from recurse(x)


def one(node, v, env):
    for x in evaluate(node, v, env):
        return x
    return None


def paths_of(node, v, env):
    """Paths for the path expressions people pass to del, path and to_entries-style helpers."""
    kind = node[0]
    if kind == 'dot':
        yield []
    elif kind == 'field':
        yield [node[1]]
    elif kind == 'index':
        for k in evaluate(node[1], v, env):
            yield [k]
    elif kind == 'iter':
        if isinstance(v, list):
            yield from ([i] for i in range(len(v)))
        elif isinstance(v, dict):
            yield from ([k] for k in v)
        elif v is not None:
            raise JqError('Cannot iterate over ' + jtype(v))
    elif kind == 'pipe':
        for p in paths_of(node[1], v, env):
            sub = getpath(v, p)
            for q in paths_of(node[2], sub, env):
                yield p + q
    elif kind == 'comma':
        yield from paths_of(node[1], v, env)
        yield from paths_of(node[2], v, env)
    elif kind == 'call' and node[1] == 'select':
        if any(truthy(c) for c in evaluate(node[2][0], v, env)):
            yield []
    elif kind == 'call' and node[1] in ('empty',):
        return
    elif kind == 'recurse':
        yield from all_paths(v, [])
    elif kind == 'try':
        try:
            yield from list(paths_of(node[1], v, env))
        except JqError:
            return
    elif kind == 'if':
        for c in evaluate(node[1], v, env):
            yield from paths_of(node[2] if truthy(c) else node[3], v, env)
    else:
        raise JqUnsupported('path expression ' + kind)


def all_paths(v, prefix):
    yield prefix
    if isinstance(v, list):
        for i, x in enumerate(v):
            yield from all_paths(x, prefix + [i])
    elif isinstance(v, dict):
        for k, x in v.items():
            yield from all_paths(x, prefix + [k])


def getpath(v, path):
    for k in path:
        if v is None:
            return None
        v = index_value(v, k)
    return v


def delpaths(v, paths):
    for path in sorted(paths, key=lambda p: [sort_key(x) for x in p], reverse=True):
        v = delpath(v, path)
    return v


def delpath(v, path):
    if not path:
        return None
    if v is None:
        return None
    head, rest = path[0], path[1:]
    if isinstance(v, dict):
        out = dict(v)
        if rest:
            if head in out:
                out[head] = delpath(out[head], rest)
        else:
            out.pop(head, None)
        return out
    if isinstance(v, list):
        out = list(v)
        idx = head if head >= 0 else head + len(out)
        if 0 <= idx < len(out):
            if rest:
                out[idx] = delpath(out[idx], rest)
            else:
                del out[idx]
        return out
    raise JqError('Cannot delete field of ' + jtype(v))


def call(name, args, v, env):
    arity = len(args)
    a = args
    key = (name, arity)
    simple = {
        ('empty', 0): lambda: [],
        ('not', 0): lambda: [not truthy(v)],
        ('length', 0): lambda: [length(v)],
        ('utf8bytelength', 0): lambda: [len(v.encode())],
        ('keys', 0): lambda: [sorted(v) if isinstance(v, dict) else list(range(len(v)))],
        ('keys_unsorted', 0): lambda: [list(v) if isinstance(v, dict) else list(range(len(v)))],
        ('values', 0): lambda: [v] if v is not None else [],
        ('add', 0): lambda: [add_all(iterate(v))],
        ('any', 0): lambda: [any(truthy(x) for x in iterate(v))],
        ('all', 0): lambda: [all(truthy(x) for x in iterate(v))],
        ('first', 0): lambda: [index_value(v, 0)],
        ('last', 0): lambda: [index_value(v, -1)],
        ('reverse', 0): lambda: [v[::-1] if v is not None else []],
        ('sort', 0): lambda: [sorted(iterate(v), key=sort_key)],
        ('unique', 0): lambda: [unique_by(iterate(v), lambda x: x)],
        ('min', 0): lambda: [min(iterate(v), key=sort_key) if v else None],
        ('max', 0): lambda: [max(iterate(v), key=sort_key) if v else None],
        ('flatten', 0): lambda: [flatten(v, 1e9)],
        ('tostring', 0): lambda: [tostr(v)],
        ('tonumber', 0): lambda: [tonumber(v)],
        ('tojson', 0): lambda: [tojson(v)],
        ('fromjson', 0): lambda: [json.loads(v)],
        ('type', 0): lambda: [jtype(v)],
        ('ascii_downcase', 0): lambda: [v.lower()],
        ('ascii_upcase', 0): lambda: [v.upper()],
        ('to_entries', 0): lambda: [[{'key': k, 'value': x} for k, x in (v.items() if isinstance(v, dict) else enumerate(v))]],
        ('from_entries', 0): lambda: [from_entries(v)],
        ('floor', 0): lambda: [math.floor(v)],
        ('ceil', 0): lambda: [math.ceil(v)],
        ('round', 0): lambda: [round(v)],
        ('fabs', 0): lambda: [abs(v)],
        ('abs', 0): lambda: [abs(v)],
        ('sqrt', 0): lambda: [norm(math.sqrt(v))],
        ('arrays', 0): lambda: [v] if isinstance(v, list) else [],
        ('objects', 0): lambda: [v] if isinstance(v, dict) else [],
        ('strings', 0): lambda: [v] if isinstance(v, str) else [],
        ('numbers', 0): lambda: [v] if jtype(v) == 'number' else [],
        ('booleans', 0): lambda: [v] if isinstance(v, bool) else [],
        ('nulls', 0): lambda: [v] if v is None else [],
        ('iterables', 0): lambda: [v] if isinstance(v, (list, dict)) else [],
        ('scalars', 0): lambda: [v] if not isinstance(v, (list, dict)) else [],
        ('recurse', 0): lambda: list(recurse(v)),
        ('env', 0): lambda: [dict(os.environ)],
        ('now', 0): lambda: [iso_parse('2026-10-03T00:00:00Z')],
        ('fromdateiso8601', 0): lambda: [norm(iso_parse(v))],
        ('fromdate', 0): lambda: [norm(iso_parse(v))],
        ('todateiso8601', 0): lambda: [datetime.datetime.fromtimestamp(v, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')],
        ('todate', 0): lambda: [datetime.datetime.fromtimestamp(v, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')],
        ('paths', 0): lambda: [p for p in all_paths(v, []) if p],
        ('leaf_paths', 0): lambda: [p for p in all_paths(v, []) if p and not isinstance(getpath(v, p), (list, dict))],
        ('tostream', 0): lambda: [[p, getpath(v, p)] for p in all_paths(v, []) if not isinstance(getpath(v, p), (list, dict))],
        ('explode', 0): lambda: [[ord(c) for c in v]],
        ('implode', 0): lambda: [''.join(chr(c) for c in v)],
        ('ascii', 0): lambda: [chr(v)],
        ('isnan', 0): lambda: [isinstance(v, float) and math.isnan(v)],
        ('infinite', 0): lambda: [float('inf')],
