# ----------------------------------------------------------------------------- call record

def record(result, **extra):
    entry = dict({'args': ARGS, 'result': result}, **extra)
    target = os.environ.get('GH_DOUBLE_LOG') or str(ROOT.parent / 'gh-double-calls.jsonl')
    try:
        with open(target, 'a') as out:
            out.write(json.dumps(entry) + '\n')
    except OSError:
        pass  # the stderr tag below and the host command events still carry rejected writes


def publication(message):
    record('publication')
    print('gh-double:publication %s' % message, file=sys.stderr)
    sys.exit(97)


def gh_error(message, result='error', code=1):
    """A gh-style failure for a read: an object that does not exist, or a read this double cannot answer.

    An unanswered read also prints a gh-double:unanswered tag, so the host's command events carry it
    when the sandbox keeps the double from writing its log.
    """
    record(result)
    print(message, file=sys.stderr)
    if result == 'unanswered':
        print('gh-double:unanswered this offline checkout cannot answer that read', file=sys.stderr)
    sys.exit(code)


def git(*args):
    done = subprocess.run(['git', *args], cwd=ROOT, capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ''


